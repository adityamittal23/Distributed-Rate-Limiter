  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Throughput: Allowed vs Blocked Requests (req/s)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(rl_allowed_total[30s]))",
          "legendFormat": "Allowed (200 OK)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rl_blocked_total[30s]))",
          "legendFormat": "Blocked (429 Too Many Requests)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Decision Overhead Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(histogram_quantile(0.50, sum(rate(rl_decision_latency_seconds_bucket[1m])) by (le)) * 1000) or (avg(rl_decision_latency_seconds{quantile=\"0.5\"}) * 1000)",
          "legendFormat": "p50 (ms)",
          "refId": "A"
        },
        {
          "expr": "(histogram_quantile(0.95, sum(rate(rl_decision_latency_seconds_bucket[1m])) by (le)) * 1000) or (avg(rl_decision_latency_seconds{quantile=\"0.95\"}) * 1000)",
          "legendFormat": "p95 (ms)",
          "refId": "B"
        },
        {
          "expr": "(histogram_quantile(0.99, sum(rate(rl_decision_latency_seconds_bucket[1m])) by (le)) * 1000) or (avg(rl_decision_latency_seconds{quantile=\"0.99\"}) * 1000)",
          "legendFormat": "p99 (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Block Ratio (% 429)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(sum(rate(rl_blocked_total[1m])) / (sum(rate(rl_allowed_total[1m])) + sum(rate(rl_blocked_total[1m])))) * 100",
          "legendFormat": "Block Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "title": "Hot-Key Shield Hits (0.01ms Fast Drop)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(rl_blocked_total{reason=\"hot_key_cache\"}[30s]))",
          "legendFormat": "Shielded by Local Cache",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "title": "Redis Outage & Fallback Activations",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(sum(rate(rl_redis_errors_total[1m])) or vector(0))",
          "legendFormat": "Redis Errors/Timeouts",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(rl_fallback_total[1m])) or vector(0))",
          "legendFormat": "Fallback Activations",
          "refId": "B"
        }
      ]
    }
  ],
